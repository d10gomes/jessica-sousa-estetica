          "type": "host",
          "value": "jessica-sousa-estetica.vercel.app"
        }
      ],
      "destination": "https://www.jessicasousaestetica.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/bio",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/stories",
      "destination": "/?utm_source=instagram&utm_medium=stories",
      "permanent": false
    },
    {
      "source": "/destaque",
